# Firebase Client Config (safe to expose in client, restricted by API key settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=captain-campus-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=captaincampus
VITE_FIREBASE_STORAGE_BUCKET=captain-campus-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=captaincampus
VITE_FIREBASE_DATABASE_URL=https://captain-campus-dev-default-rtdb.firebaseio.com

# Google Maps (restrict to your admin web domain)
VITE_GOOGLE_MAPS_API_KEY=your_maps_api_key

# Backend API URL
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Set to 'true' to use Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATOR=true
