# Firebase Admin SDK
# Option A: Service Account JSON file path
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Option B: Individual env vars (use one or the other)
# FIREBASE_PROJECT_ID=captain-campus-dev
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@captain-campus-dev.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Firebase project
FIREBASE_PROJECT_ID=captain-campus-dev
FIREBASE_DATABASE_URL=https://captain-campus-dev-default-rtdb.firebaseio.com

# App config
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Google Maps Platform
GOOGLE_MAPS_API_KEY=YOUR_SERVER_SIDE_MAPS_API_KEY

# GPS device auth (shared secret for device token validation in dev)
# In production use Firebase custom tokens or service accounts
GPS_DEVICE_SECRET=change_this_to_a_long_random_secret_in_production

# Emulator flags (set to true when using Firebase Emulator Suite)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
